# Sao chép thành .env (KHÔNG commit). Dùng: set -a; . ./.env; set +a; bash cf/deploy.sh
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
KV_NAMESPACE_ID=YOUR_KV_NAMESPACE_ID
# Mật khẩu chung để vào trang; Worker chỉ nhận hash (PAGE_HASH)
PAGE_PASSWORD=YOUR_PAGE_PASSWORD
# Khóa đọc / ghi API cho bot (Worker lưu READ_HASH / WRITE_HASH)
READ_KEY=YOUR_READ_KEY
WRITE_KEY=YOUR_WRITE_KEY
# Tùy chọn: webhook khi có tác vụ mới
HQ_WEBHOOK_URL=
HQ_WEBHOOK_KEY=
